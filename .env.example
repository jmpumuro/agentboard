PORT=4173
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:4173
# Optional: omit for local file storage (one process only).
# DATABASE_URL=postgresql://agentboard:agentboard-local@127.0.0.1:55440/agentboard
# OPENAI_API_KEY=
RUN_MODEL=gpt-4.1-mini
RUN_MAX_TOKENS=120000
RUN_MAX_COMPLETION_TOKENS=12000
# Required only for storing external MCP credentials or webhook signing secrets.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SECRET_ENCRYPTION_KEY=

# Optional: reference an existing local provider env file (imports only OpenAI key/model).
# OPENAI_ENV_FILE=../duligence/.env
# BOOTSTRAP_INTEGRATION_AGENT=true
